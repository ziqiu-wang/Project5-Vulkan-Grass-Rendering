#version 450
#extension GL_ARB_separate_shader_objects : enable

#define ENABLE_GRAVITY 1
#define ENABLE_RECOVERY 1
#define ENABLE_WIND 1

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(std140, set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
    vec2 padding;
    // Same layout as Scene.h
    vec4 gravity;
    vec4 wind;
    vec4 cullingParameters;
    uvec4 options;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

// TODO: Add bindings to:
// 1. Store the input blades
// 2. Write out the culled blades
// 3. Write the total number of blades remaining
// Hidden blades still get simulated
layout(std430, set = 2, binding = 0) buffer InputBlades {
    Blade blades[];
} inputBlades;

layout(std430, set = 2, binding = 1) writeonly buffer VisibleBlades {
    Blade blades[];
} visibleBlades;

layout(std430, set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

layout(set = 2, binding = 3) uniform ModelBufferObject {
    mat4 model;
};

