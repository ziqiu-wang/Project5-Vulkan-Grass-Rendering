bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

// Width along the ground
vec3 bladeWidthDirection(vec3 up, float angle) {
    vec3 reference = abs(up.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(reference - up * dot(reference, up));
    vec3 bitangent = cross(tangent, up);
    return cos(angle) * tangent + sin(angle) * bitangent;
}

void simulateBlade(inout Blade blade) {
    vec3 base = blade.v0.xyz;
    vec3 up = normalize(blade.up.xyz);
    float height = blade.v1.w;
    vec3 tip = blade.v2.xyz;
    vec3 recovery = vec3(0.0);
    vec3 totalGravity = vec3(0.0);
    vec3 windForce = vec3(0.0);

    // Recovery and gravity
#if ENABLE_RECOVERY
    vec3 restTip = base + height * up;
    recovery = (restTip - tip) * blade.up.w;
#endif

#if ENABLE_GRAVITY
    vec3 widthDirection = bladeWidthDirection(up, blade.v0.w);
    vec3 frontDirection = normalize(cross(widthDirection, up));
    vec3 environmentalGravity = normalize(gravity.xyz) * gravity.w;
    totalGravity = environmentalGravity + 0.25 * length(environmentalGravity) * frontDirection;
#endif

#if ENABLE_WIND
    vec3 windDirection = normalize(wind.xyz);
    float phase = dot(base, vec3(0.60, 0.0, 0.40)) - 2.0 * totalTime;
    float gust = 0.6 + 0.25 * sin(phase) + 0.1 * cos(2.5 * phase + totalTime);
    vec3 windInfluence = windDirection * wind.w * gust;

    // Wind alignment: paper equations 7-8
    float directionalAlignment = 1.0 - abs(dot(windDirection, normalize(tip - base)));
    float heightRatio = clamp(dot(tip - base, up) / height, 0.0, 1.0);
    windForce = windInfluence * directionalAlignment * heightRatio;
#endif
    tip += (totalGravity + recovery + windForce) * deltaTime;

    // Keep the tip above ground
    tip -= up * min(dot(up, tip - base), 0.0);

    // v1 height: paper equation 11
    vec3 displacement = tip - base;
    float projectedLength = length(displacement - up * dot(displacement, up));
    float bendRatio = projectedLength / height;
    vec3 v1 = base + height * up * max(1.0 - bendRatio, 0.05 * max(bendRatio, 1.0));

    // Keep the blade's length
    float chordLength = length(tip - base);
    float polygonLength = length(v1 - base) + length(tip - v1);
    float curveLength = (2.0 * chordLength + polygonLength) / 3.0;
    float lengthRatio = height / curveLength;
    // Save this before moving the v1
    vec3 secondSegment = tip - v1;
    v1 = base + lengthRatio * (v1 - base);
    tip = v1 + lengthRatio * secondSegment;

    blade.v1.xyz = v1;
    blade.v2.xyz = tip;
}

// Source: https://github.com/skeeto/hash-prospector
uint hashBlade(uint id) {
    id ^= id >> 16;
    id *= 0x7feb352du;
    id ^= id >> 15;
    id *= 0x846ca68bu;
    return id ^ (id >> 16);
}

bool insideFrustum(vec3 point, float bladeWidth) {
    vec4 clip = camera.proj * camera.view * vec4(point, 1.0);
    // Include width near screen edges
    float tolerance = cullingParameters.w * abs(clip.w)
        + 0.5 * bladeWidth * max(abs(camera.proj[0][0]), abs(camera.proj[1][1]));
    // Vulkan depth is [0,w]
    return clip.w > 0.0 && inBounds(clip.x, clip.w + tolerance)
        && inBounds(clip.y, clip.w + tolerance)
        && clip.z >= -tolerance && clip.z <= clip.w + tolerance;
}

bool isVisible(Blade blade, uint id) {
    vec3 base = (model * vec4(blade.v0.xyz, 1.0)).xyz;
    vec3 tip = (model * vec4(blade.v2.xyz, 1.0)).xyz;
    vec3 localUp = normalize(blade.up.xyz);
    vec3 up = normalize(transpose(inverse(mat3(model))) * localUp);
    vec3 transformedWidth = mat3(model) * bladeWidthDirection(localUp, blade.v0.w);
    vec3 widthDirection = normalize(transformedWidth);
    float width = blade.v2.w * length(transformedWidth);

    // Undo the camera's rigid transform
    vec3 cameraPosition = -transpose(mat3(camera.view)) * camera.view[3].xyz;
    vec3 cameraToBlade = base - cameraPosition;

    // Skip nearly edge-on blades
    if ((options.x & 1u) != 0u
        && abs(dot(normalize(cameraToBlade), widthDirection)) > cullingParameters.x) {
        return false;
    }

    if ((options.x & 4u) != 0u) {
        // Ignore camera height: paper equation 19
        float distanceToCamera = length(cameraToBlade - up * dot(cameraToBlade, up));
        float maximumDistance = cullingParameters.y;
        if (distanceToCamera >= maximumDistance) {
            return false;
        }
        uint buckets = uint(cullingParameters.z);
        uint bucket = uint(floor(distanceToCamera / maximumDistance * float(buckets)));
        // Thin more in farther buckets
        if (hashBlade(id) % buckets < bucket) {
            return false;
        }
    }

    if ((options.x & 2u) != 0u) {
        // Curve midpoint at v=0.5
        vec3 midpoint = (model * vec4(0.25 * blade.v0.xyz + 0.5 * blade.v1.xyz + 0.25 * blade.v2.xyz, 1.0)).xyz;
        if (!insideFrustum(base, width) && !insideFrustum(tip, width) && !insideFrustum(midpoint, width)) {
            return false;
        }
    }
    return true;
}

void main() {
	// Reset the number of blades to 0
		// numBlades.vertexCount = 0;
    // Reset happens before dispatch
    // Wait till all threads reach this point
    // No shader barrier needed here

    uint id = gl_GlobalInvocationID.x;
    // Skip threads beyond the blade count
    if (id >= uint(inputBlades.blades.length())) {
        return;
    }

    // TODO: Apply forces on every blade and update the vertices in the buffer
    Blade blade = inputBlades.blades[id];
    simulateBlade(blade);
    inputBlades.blades[id] = blade;

	// TODO: Cull blades that are too far away or not in the camera frustum and write them
	// to the culled blades buffer
	// Note: to do this, you will need to use an atomic operation to read and update numBlades.vertexCount
	// You want to write the visible blades to the buffer without write conflicts between threads
    if (isVisible(blade, id)) {
        uint visibleIndex = atomicAdd(numBlades.vertexCount, 1u);
        visibleBlades.blades[visibleIndex] = blade;
    }
}
